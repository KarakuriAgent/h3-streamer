# fal.ai API key. The daemon keeps this server-side and never exposes it to the
# viewer page; the page talks to fal through the daemon's /api/fal/proxy.
FAL_KEY=

# YouTube RTMP stream key (used by OBS / the broadcaster, optional for now).
RTMP_KEY=
RTMP_URL=rtmp://a.rtmp.youtube.com/live2

# YouTube Data API v3 API key (config/youtube.yaml の auth: api_key で使う。推奨)。
# Google Cloud → API とサービス → 認証情報 → API キー。docs/youtube-setup.md を参照。
YOUTUBE_API_KEY=

# YouTube Data API OAuth (config/youtube.yaml の auth: oauth のときだけ必要)。
YOUTUBE_CLIENT_SECRET=./config/client_secret.json
YOUTUBE_TOKEN=./state/youtube_token.json

# OpenAI 互換の音声合成 API が Bearer 認証を要求するときだけ。
# characters/<name>/voice/tts.yaml の api_key より優先される。
TTS_API_KEY=

# 設定 yaml に書いた ${VAR} は環境変数（この .env 込み）に展開される。
# このリポジトリの外を指すパスは yaml に直書きせず、ここに置く。例：
#   characters/<name>/voice/tts.yaml
#     extra_body:
#       irodori:
#         lora_adapter: ${MY_CHARACTER_LORA}
# MY_CHARACTER_LORA=<path-to-lora-checkpoint>
